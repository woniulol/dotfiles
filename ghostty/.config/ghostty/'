# Try to attach/init the tmux session and allow exit tmux to have a plain terminal.
# command = "$SHELL -l -c 'tmux attach || tmux; clear; exec $SHELL -l'"

# font-family = Cascadia Mono
# font-family = Mononoki Nerd Font Mono
font-family = JetBrainsMono Nerd Font Mono
font-family-bold = JetBrainsMono Nerd Font Mono SemiBold
font-family-italic = JetBrainsMono Nerd Font Mono Italic
font-family-bold-italic = JetBrainsMono Nerd Font Mono SemiBold Italic 
font-size = 18
adjust-cell-width=-5%
adjust-cell-height=-5%
font-feature = -liga
font-feature = -clig
font-feature = -calt

# theme = Catppuccin Macchiato
theme = Catppuccin Mocha
# theme = Catppuccin Frappe
# theme = Catppuccin Latte
# theme = TokyoNight Night
# Increase visibility for Bright Black (Color 8)
# This affects the dashes in ls -l and other UI elements
# palette = 7=#BDBDBD
