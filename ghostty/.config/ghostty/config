# Try to attach/init the tmux session and allow exit tmux to have a plain terminal.
#
# command = "$SHELL -l -c 'tmux attach || tmux; clear; exec $SHELL -l'"

font-family = Hack Nerd Font Mono
font-family-bold = Hack Nerd Font Mono Bold
font-family-italic = Hack Nerd Font Mono Italic
font-family-bold-italic = Hack Nerd Font Mono Bold Italic

# font-style = "Regular"
# font-style-bold = "ExtraBold"
# font-style-italic = "Italic"
# font-style-bold-italic = "Bold Italic"

# font-family = JetBrainsMono Nerd Font Mono
# font-family-bold = JetBrainsMono Nerd Font Mono SemiBold
# font-family-italic = JetBrainsMono Nerd Font Mono Italic
# font-family-bold-italic = JetBrainsMono Nerd Font Mono SemiBold Italic

# font-family = FiraCode Nerd Font Mono
# font-family-bold = Hasklug Nerd Font Mono Black
# font-family-italic = Hasklug Nerd Font Mono Med Italic
# font-family-bold-italic = Hasklug Nerd Font Mono Bold Italic

font-size = 18
adjust-cell-width=-6%
adjust-cell-height=+8%
# font-feature = -liga
# font-feature = -clig
# font-feature = -calt

# theme = Catppuccin Macchiato
# theme = Black Metal (Dark Funeral)
# theme = Catppuccin Mocha
# theme = Catppuccin Frappe
# theme = Catppuccin Latte
# theme = TokyoNight Night

# ─── 16-color palette ──────────────────────────────────────────────
# black
palette = 0=#454560
# red
palette = 1=#ff7a8a
# green
palette = 2=#a8e078
# yellow
palette = 3=#ffd778
# blue
palette = 4=#7fb5ff
# magenta
palette = 5=#c89aff
# cyan
palette = 6=#7fd8e6
# white
palette = 7=#eaecf4

# bright black (comments, prompt chrome)
palette = 8=#6e6e88
# bright red
palette = 9=#ff95a4
# bright green
palette = 10=#bce690
# bright yellow
palette = 11=#ffe28c
# bright blue
palette = 12=#9bc9ff
# bright magenta
palette = 13=#d8b3ff
# bright cyan
palette = 14=#9bdfeb
# bright white
palette = 15=#ffffff
# ─── special colors (not part of the 16) ───────────────────────────
background             = #1e1e2e
foreground             = #ffffff
cursor-color           = #ffffff
cursor-text            = #1e1e2e
selection-background   = #3a3f5c
selection-foreground   = #ffffff

# MacOS only
# font-thicken = true
# font-thicken-strength = 128

# background-blur = 16
# background-opacity = 0.75

window-padding-balance = true
window-padding-x = 10
window-padding-y = 0
# window-save-state = always

# macos-titlebar-style = transparent
macos-titlebar-style = hidden
macos-option-as-alt = true

copy-on-select = clipboard


# custom-shader = shaders/cursor_smear_gradient.glsl
# custom-shader = shaders/cursor_smear_fade.glsl
custom-shader = shaders/cursor_smear_original.glsl
cursor-style = block
shell-integration-features = no-cursor

# Be careful that this will multiplied by the tmux scroll number of line.
mouse-scroll-multiplier = 1

# term = xterm-256color
shell-integration-features = ssh-env,ssh-terminfo,no-cursor

# Keybindings
# Shift + cmd + \ -> view all tabs.
keybind = cmd+g>s>h=new_split:left
keybind = cmd+g>s>j=new_split:down
keybind = cmd+g>s>k=new_split:up
keybind = cmd+g>s>l=new_split:right

# keybind = cmd+h=goto_split:left
# keybind = cmd+j=goto_split:down
# keybind = cmd+k=goto_split:up
# keybind = cmd+l=goto_split:right

keybind = cmd+g>s>e=equalize_splits

# Tmux leader key
# Check the plain test input with `xxd -psd`
# all cmd is mapped to meta(option/alt)
keybind = cmd+b=text:\x1b\x62
keybind = cmd+h=text:\x1b\x68
keybind = cmd+j=text:\x1b\x6a
keybind = cmd+k=text:\x1b\x6b
keybind = cmd+l=text:\x1b\x6c

keybind = cmd+digit_1=text:\x1b\x31
keybind = cmd+digit_2=text:\x1b\x32
keybind = cmd+digit_3=text:\x1b\x33
keybind = cmd+digit_4=text:\x1b\x34
keybind = cmd+digit_5=text:\x1b\x35

keybind = cmd+n=unbind
# keybind = cmd+t=unbind
