# background             = #1e1e2e
# foreground             = #ffffff
# cursor-color           = #ffffff
# cursor-text            = #1e1e2e
# selection-background   = #3a3f5c
# selection-foreground   = #ffffff

# MacOS only
font-thicken = true
font-thicken-strength = 128

# background-opacity = 0.75
# background-blur = 10

window-padding-balance = true
window-padding-x = 10
window-padding-y = 0
# window-save-state = always

# macos-titlebar-style = transparent
macos-titlebar-style = hidden
macos-option-as-alt = true
confirm-close-surface = false

copy-on-select = clipboard

# custom-shader = shaders/cursor_smear_gradient.glsl
# custom-shader = shaders/cursor_smear_fade.glsl
custom-shader = shaders/cursor_smear_original.glsl
cursor-style = block
shell-integration-features = no-cursor

# Be careful that this will multiplied by the tmux scroll number of line.
mouse-scroll-multiplier = 1

# term = xterm-256color
shell-integration-features = ssh-env,ssh-terminfo,no-cursor

# Keybindings
# Shift + cmd + \ -> view all tabs.
keybind = cmd+b>s>h=new_split:left
keybind = cmd+b>s>j=new_split:down
keybind = cmd+b>s>k=new_split:up
keybind = cmd+b>s>l=new_split:right
keybind = cmd+b>s>e=equalize_splits

keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

