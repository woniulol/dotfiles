


font-family = JetBrainsMono Nerd Font Mono

font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"

font-size = 16
adjust-cell-width=-10%
adjust-cell-height=-10%
font-feature = -liga
font-feature = -clig
font-feature = -calt


theme = nekomi
cursor-color = #fec270

# MacOS only
font-thicken = true
font-thicken-strength = 128

# background-opacity = 0.75
# background-blur = 10

window-padding-balance = true
window-padding-x = 10
window-padding-y = 0
# window-save-state = always

# macos-titlebar-style = transparent
macos-titlebar-style = hidden
macos-option-as-alt = true
confirm-close-surface = false

copy-on-select = clipboard

# custom-shader = shaders/cursor_smear_gradient.glsl
# custom-shader = shaders/cursor_smear_fade.glsl
# custom-shader = shaders/cursor_smear_original.glsl
cursor-style = block
cursor-style-blink = false

# Be careful that this will multiplied by the tmux scroll number of line.
mouse-scroll-multiplier = 1

# term = xterm-256color
shell-integration-features = ssh-env,ssh-terminfo,no-cursor

# Keybindings
# Shift + cmd + \ -> view all tabs.

# Multiplexer keys
# Check the plain text input with `xxd -psd`
# all cmd is mapped to meta(option/alt)
keybind = cmd+b=text:\x1b\x62
keybind = cmd+n=text:\x1b\x6e
keybind = cmd+w=text:\x1b\x77
keybind = cmd+h=text:\x1b\x68
keybind = cmd+j=text:\x1b\x6a
keybind = cmd+k=text:\x1b\x6b
keybind = cmd+l=text:\x1b\x6c

keybind = cmd+digit_1=text:\x1b\x31
keybind = cmd+digit_2=text:\x1b\x32
keybind = cmd+digit_3=text:\x1b\x33
keybind = cmd+digit_4=text:\x1b\x34
keybind = cmd+digit_5=text:\x1b\x35
keybind = cmd+digit_6=text:\x1b\x36
keybind = cmd+digit_7=text:\x1b\x37
keybind = cmd+digit_8=text:\x1b\x38
keybind = cmd+digit_9=text:\x1b\x39
