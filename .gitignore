**/.DS_Store
**/node_modules/
*.swp

# Pi runtime/sensitive files
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/

# Don't track the tmux plugins, but keep the folder there.
tmux/.tmux/plugins/*
!tmux/.tmux/plugins/.gitkeep

# herdr writes runtime state here, since ~/.config/herdr links to this folder.
herdr/.config/herdr/*.log
herdr/.config/herdr/*.bak
herdr/.config/herdr/*.sock*
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/
herdr/.config/herdr/sessions/
herdr/.config/herdr/release-notes.json
